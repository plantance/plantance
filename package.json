{
  "name": "plantance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plantance — plain-English to a live, owned CRUD app. The outer loop Goose does not provide.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "fetch:goose": "node scripts/fetch-goose.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "4.136.2"
  }
}
